# Neon (Postgres serverless). El sufijo ?sslmode=require es obligatorio.
# Esta es la POOLED (el host lleva "-pooler"): es la que usa la app en runtime.
# La integración de Neon en Vercel la inyecta con este mismo nombre.
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/sdr?sslmode=require

# Conexión DIRECTA, sin PgBouncer. Solo para migraciones: en modo transacción el
# pooler rompe el DDL que necesita estado de sesión. En Vercel la inyecta la
# integración de Neon con este nombre; en local, cópiala del panel de Neon.
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxx.eu-central-1.aws.neon.tech/sdr?sslmode=require

# Acceso al dashboard: una sola contraseña, un solo usuario.
DASHBOARD_PASSWORD=cambia-esto
# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-32-bytes-aleatorios

# Header x-api-key con el que n8n llama a /api/*. Genera otra distinta.
N8N_SHARED_SECRET=cambia-esto-tambien

# Webhook de n8n al que /api/messages/sweep reinyecta las respuestas que
# encuentra sin contestar. Es el mismo que recibe los entrantes de Unipile.
N8N_INBOUND_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/sdr-unipile-inbound

# LLM. El modelo concreto se elige desde /settings, no aquí.
OPENROUTER_API_KEY=sk-or-v1-...

# Apify: prospección. Token en https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_...

# Unipile (LinkedIn + Instagram + email)
UNIPILE_API_KEY=
UNIPILE_DSN=api8.unipile.com:13843

# Meta: webhook de Instagram (comentarios y mensajes).
# El secreto de la app está en developers.facebook.com > Configuración básica.
# El token de verificación te lo inventas tú: es el que Meta te devuelve al
# validar la URL, y tiene que ser el mismo aquí y en el panel de Meta.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Composio (Google Calendar)
COMPOSIO_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL pública del dashboard, se usa en los enlaces de los avisos de Telegram.
NEXT_PUBLIC_APP_URL=http://localhost:3000

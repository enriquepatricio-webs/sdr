    {
      "id": "005f1e7f-a742-4804-856a-3ed39d6894f3",
      "name": "Redactar seguimiento",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Escribe un SEGUIMIENTO. El prospecto no ha contestado al mensaje anterior.\n\nNombre: {{ $('Lead a lead').item.json.fullName }}\nEmpresa: {{ $('Lead a lead').item.json.company || '-' }}\nToques ya enviados: {{ $('Lead a lead').item.json.touchCount }}\n\nLo que ya le has escrito:\n{{ ($('Hilo previo').item.json.hilo || []).map(m => m.quien + ': ' + m.texto).join(' | ') || '(sin historial)' }}\n\nNO repitas el mensaje anterior con otras palabras: cambia de ángulo, aporta algo nuevo y corto, y cierra con una pregunta distinta. Máximo 3 líneas. Devuelve SOLO el texto del mensaje.",
        "options": {
          "systemMessage": "={{ $('Playbook activo').item.json.systemPrompt }}",
          "maxIterations": 3
        }
      }
    },
    {
      "id": "678e4294-2861-4b10-b71b-329bed1b1d93",
      "name": "OpenRouter",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1540,
        220
      ],
      "parameters": {
        "model": "deepseek/deepseek-v4-flash",
        "options": {
          "temperature": 0.8,
          "maxTokens": 4000
        }
      }
    },
    {
      "id": "4db8005c-f894-4f26-89f1-63c0af1591cd",
      "name": "Enviar o dejar borrador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/messages/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": \"{{ $('Lead a lead').item.json.id }}\", \"texto\": {{ JSON.stringify($json.output) }}, \"step\": {{ ($('Lead a lead').item.json.touchCount || 0) + 1 }}, \"tipo\": \"mensaje\", \"chatId\": \"{{ $('Hilo previo').item.json.chatId }}\", \"nuevoEstado\": \"en_seguimiento\", \"nextActionAt\": \"{{ $now.plus(5, 'days').toISO() }}\" }",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "735adc12-03af-4e31-b088-981dc14ec0b6",
      "name": "Esperar 90-420 s",

{
  "name": "sdr-inbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "unipile-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook de Unipile",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        200
      ],
      "webhookId": "unipile-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Unipile mete NUESTROS propios mensajes en message_received. Sin esta\n// comprobación el agente lee su mensaje como si fuera una respuesta del\n// prospecto, contesta, y entra en bucle sobre un hilo con una persona real.\nconst p = $input.first().json.body ?? $input.first().json;\nconst nuestroUserId = p.account_info?.user_id;\nconst remitente = p.sender?.attendee_provider_id ?? null;\nreturn [{ json: {\n  esNuestro: Boolean(nuestroUserId && remitente && nuestroUserId === remitente),\n  esMensaje: !p.event || p.event === \"message_received\",\n  messageId: p.message_id, chatId: p.chat_id, accountId: p.account_id,\n  texto: p.message ?? \"\", providerId: remitente,\n  nombre: p.sender?.attendee_name ?? null,\n} }];"
      },
      "id": "interpretar",
      "name": "Interpretar webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.esNuestro }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            },
            {
              "leftValue": "={{ $json.esMensaje }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "es-del-prospecto",
      "name": "¿Lo ha escrito el prospecto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/touches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $('Resolver lead').item.json.lead.id, channel: $('Resolver lead').item.json.campana.channel, direction: \"in\", status: \"enviado\", sentAt: new Date().toISOString(), body: $('Interpretar webhook').item.json.texto, unipileMessageId: $('Interpretar webhook').item.json.messageId, unipileChatId: $('Interpretar webhook').item.json.chatId }) }}"
      },
      "id": "registrar-entrante",
      "name": "Registrar entrante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "SDR API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://sdr.thecotocompany.com/api/leads/resolve?chat_id={{ $json.chatId }}&provider_id={{ $json.providerId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "id": "resolver-lead",
      "name": "Resolver lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "SDR API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicado }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            },
            {
              "leftValue": "={{ $('Resolver lead').item.json.congelado }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "procede",
      "name": "¿Nuevo y no congelado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [

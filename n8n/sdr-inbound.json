{
  "name": "SDR · 2 · Conversación entrante",
  "nodes": [
    {
      "id": "1fffb141-a0c5-4dd8-8eda-709440caaf47",
      "name": "Webhook de Unipile",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sdr-unipile-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6762fda6-28c7-41c7-845c-98eed0ed517e"
    },
    {
      "id": "8a9c8d0c-ae99-492d-bb40-65b5b25417d9",
      "name": "Interpretar webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst p = raw.body ?? raw;\nconst nuestroUserId = p.account_info?.user_id;\nconst remitente = p.sender?.attendee_provider_id ?? null;\nreturn [{ json: {\n  esNuestro: Boolean(nuestroUserId && remitente && nuestroUserId === remitente),\n  esMensaje: !p.event || p.event === \"message_received\",\n  messageId: p.message_id ?? null,\n  chatId: p.chat_id ?? null,\n  accountId: p.account_id ?? null,\n  texto: p.message ?? \"\",\n  providerId: remitente,\n  nombre: p.sender?.attendee_name ?? null,\n} }];"
      }
    },
    {
      "id": "a6e664d4-7739-4dd9-b88a-9b429975c1c2",
      "name": "Lo escribió el prospecto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.esNuestro }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.esMensaje }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "88dc5420-3bb8-4982-aec3-5a4c436cb541",
      "name": "Resolver lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://sdr.thecotocompany.com/api/leads/resolve?chat_id={{ $json.chatId }}&provider_id={{ $json.providerId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "678537d7-284d-41b9-b2d5-50237a6aa11b",
      "name": "Registrar entrante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/touches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": \"{{ $json.lead.id }}\", \"channel\": \"{{ $json.campana.channel }}\", \"direction\": \"in\", \"status\": \"enviado\", \"sentAt\": \"{{ $now.toISO() }}\", \"body\": {{ JSON.stringify($(\"Interpretar webhook\").item.json.texto) }}, \"unipileMessageId\": \"{{ $(\"Interpretar webhook\").item.json.messageId }}\", \"unipileChatId\": \"{{ $(\"Interpretar webhook\").item.json.chatId }}\" }",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "9a059769-e5e0-4249-aafa-ae59154ac2de",
      "name": "Nuevo y no congelado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicado }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $(\"Resolver lead\").item.json.congelado }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c8b54ffc-e337-4cd8-b6c0-40a524ae3c15",
      "name": "Playbook activo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://sdr.thecotocompany.com/api/playbook/active?campaign_id={{ $(\"Resolver lead\").item.json.campana.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "1c495861-00cc-4004-933e-009bf5129fe2",
      "name": "Agente SDR",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=El prospecto acaba de escribir:\n\n«{{ $(\"Interpretar webhook\").item.json.texto }}»\n\nleadId para las herramientas: {{ $(\"Resolver lead\").item.json.lead.id }}\nchatId: {{ $(\"Interpretar webhook\").item.json.chatId }}\n\nDatos del lead: {{ JSON.stringify($(\"Resolver lead\").item.json.lead) }}\n\nConversación hasta ahora:\n{{ ($(\"Resolver lead\").item.json.hilo || []).map(m => m.quien + \": \" + m.texto).join(\" | \") }}\n\nDecide y actúa con las herramientas. Responde SIEMPRE llamando a la herramienta responder, nunca solo con texto.",
        "options": {
          "systemMessage": "={{ $json.systemPrompt }}",
          "maxIterations": 12
        }
      }
    },
    {
      "id": "247ac762-8074-417b-ac5a-cd049a03451f",
      "name": "OpenRouter",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1540,
        280
      ],
      "parameters": {
        "model": "deepseek/deepseek-v4-flash",
        "options": {
          "temperature": 0.6,
          "maxTokens": 8000
        }
      }
    },
    {
      "id": "d3ed77a8-167d-49f2-8ad0-8ccceb5d7e59",
      "name": "Memoria del hilo",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        1740,
        280
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Interpretar webhook').item.json.chatId }}",
        "contextWindowLength": 20
      }
    },
    {
      "id": "7874e4d3-458e-4471-93ab-8f57a7697b9d",
      "name": "registrar_cualificacion",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        -320
      ],
      "parameters": {
        "toolDescription": "Guarda el resultado de la cualificación del prospecto. OBLIGATORIA antes de intentar agendar: sin ella, agendar_reunion devuelve 409.",
        "method": "POST",
        "url": "=https://sdr.thecotocompany.com/api/leads/{{ $fromAI('leadId','Id del lead','string') }}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": {{ JSON.stringify($fromAI('estado','cualificando, cualificado o descartado','string')) }}, \"qualification\": { \"score\": {{ $fromAI('score','Encaje con el ICP de 0 a 100','number') }}, \"verdict\": {{ JSON.stringify($fromAI('verdict','cualificado, descartado o pendiente','string')) }}, \"reasoning\": {{ JSON.stringify($fromAI('reasoning','Senal concreta en la que te basas','string')) }}, \"summary\": {{ JSON.stringify($fromAI('summary','Una linea para el aviso de Telegram','string')) }} } }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "5b133561-24fd-4a5e-84fd-948924b76539",
      "name": "consultar_disponibilidad",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        -160
      ],
      "parameters": {
        "toolDescription": "Huecos REALES de la agenda, ya filtrados por las reglas del playbook. OBLIGATORIA antes de proponer cualquier hora. Si responde con escala true, di que confirmas en un rato y llama a escalar_humano; no propongas nada.",
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/calendar/slots",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": {{ JSON.stringify($fromAI('leadId','Id del lead','string')) }}, \"preferencia\": {{ JSON.stringify($fromAI('preferencia','manana, tarde o cualquiera segun lo que haya dicho el prospecto','string')) }} }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "a5b92199-8e22-4806-bc2b-cdf96edc4ec9",
      "name": "agendar_reunion",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        0
      ],
      "parameters": {
        "toolDescription": "Crea la reunión en el calendario con el prospecto invitado y enlace de Meet. Usa una hora que te haya devuelto consultar_disponibilidad, nunca una inventada.",
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/calendar/book",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": {{ JSON.stringify($fromAI('leadId','Id del lead','string')) }}, \"inicio\": {{ JSON.stringify($fromAI('inicio','Inicio en ISO 8601 tal cual lo devolvio consultar_disponibilidad','string')) }} }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "c35fae66-c7bd-4a10-b88d-1ba7080c12bd",
      "name": "responder",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        160
      ],
      "parameters": {
        "toolDescription": "Envía un mensaje al prospecto en el mismo hilo. Máximo 4 líneas. Con el autopiloto apagado guarda el borrador y no envía: eso es lo esperado, no un error. Si la respuesta trae un campo error, LÉELO: no vuelvas a llamar a esta herramienta con lo mismo. Si dice que la cuenta está en pausa o desconectada, llama a escalar_humano y para.",
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/messages/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": {{ JSON.stringify($fromAI('leadId','Id del lead','string')) }}, \"texto\": {{ JSON.stringify($fromAI('texto','El mensaje tal cual se lo va a leer el prospecto. Puede llevar saltos de linea','string')) }}, \"chatId\": {{ JSON.stringify($fromAI('chatId','Id del hilo de Unipile','string')) }}, \"tipo\": \"mensaje\" }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "9ce5b45a-08ed-4d5f-bc55-d006596be1a6",
      "name": "descartar",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        320
      ],
      "parameters": {
        "toolDescription": "Cierra el lead sin reunión. Usa no_interesado si ha dicho que no, descartado si no encaja con el ICP. Si pide no ser contactado, motivo baja solicitada y no le escribas nada más.",
        "method": "POST",
        "url": "=https://sdr.thecotocompany.com/api/leads/{{ $fromAI('leadId','Id del lead','string') }}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": {{ JSON.stringify($fromAI('estado','no_interesado o descartado','string')) }}, \"motivo\": {{ JSON.stringify($fromAI('motivo','Por que se cierra','string')) }} }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "9ff2418d-3943-4529-a04b-f4f4d7837b6a",
      "name": "escalar_humano",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1960,
        480
      ],
      "parameters": {
        "toolDescription": "Congela el lead y avisa por Telegram. Úsala ante enfado, confusión, una queja, una petición legal o cualquier cosa fuera del guion. Después de llamarla no vuelvas a escribir a ese prospecto.",
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"tipo\": \"escalado\", \"leadId\": {{ JSON.stringify($fromAI('leadId','Id del lead','string')) }}, \"motivo\": {{ JSON.stringify($fromAI('motivo','Que ha pasado en una frase','string')) }}, \"ultimoMensaje\": {{ JSON.stringify($fromAI('ultimoMensaje','Lo ultimo que dijo el prospecto','string')) }} }",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "aec2b5eb-9c83-4dbf-a7b0-4bd53094c0d4",
      "name": "Duplicado o congelado: ignorar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        240
      ],
      "parameters": {}
    },
    {
      "id": "00cb29d1-d59f-4e73-8778-4cd9a711b2d1",
      "name": "Es nuestro eco: ignorar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        240
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 41) + 100 }}"
      },
      "id": "esperar-2min-antes-de-contestar",
      "name": "Esperar ~2 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1210,
        0
      ],
      "notes": "Contestar al instante delata a la maquina. Va despues de registrar el entrante y de filtrar ecos: el mensaje se ve en el panel enseguida y solo se retrasa la respuesta. Aleatorio 100-140 s; el agente suma ~15 s al redactar."
    }

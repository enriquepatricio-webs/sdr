    {
      "parameters": {
        "toolDescription": "Guarda el resultado de la cualificación del prospecto. OBLIGATORIO llamarla antes de intentar agendar. score de 0 a 100, verdict \"cualificado\" | \"descartado\" | \"pendiente\", reasoning explicando en qué te basas y summary en una línea.",
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/leads/{leadId}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\": \"{estado}\", \"qualification\": {\"score\": {score}, \"verdict\": \"{verdict}\", \"reasoning\": \"{reasoning}\", \"summary\": \"{summary}\"}}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "leadId",
              "description": "Id del lead",
              "type": "string"
            },
            {
              "name": "estado",
              "description": "cualificando, cualificado o descartado",
              "type": "string"
            },
            {
              "name": "score",
              "description": "Encaje con el ICP de 0 a 100",
              "type": "number"
            },
            {
              "name": "verdict",
              "description": "cualificado, descartado o pendiente",
              "type": "string"
            },
            {
              "name": "reasoning",
              "description": "Por qué, con la señal concreta en la que te basas",
              "type": "string"
            },
            {
              "name": "summary",
              "description": "Una línea para el aviso de Telegram",
              "type": "string"
            }
          ]
        }
      },

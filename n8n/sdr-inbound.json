        "url": "=https://sdr.thecotocompany.com/api/playbook/active?campaign_id={{ $('Resolver lead').item.json.campana.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "id": "playbook-activo",
      "name": "Playbook activo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "SDR API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"El prospecto acaba de escribir:\\n\\n«\" + $('Interpretar webhook').item.json.texto + \"»\\n\\nDatos del lead (leadId para las tools: \" + $('Resolver lead').item.json.lead.id + \", chatId: \" + $('Interpretar webhook').item.json.chatId + \"):\\n\" + JSON.stringify({ nombre: $('Resolver lead').item.json.lead.fullName, titular: $('Resolver lead').item.json.lead.headline, empresa: $('Resolver lead').item.json.lead.company, score: $('Resolver lead').item.json.lead.score }) + \"\\n\\nConversación hasta ahora:\\n\" + $('Resolver lead').item.json.hilo.map(m => m.quien + \": \" + m.texto).join(\"\\n\") + \"\\n\\nDecide y actúa usando las herramientas. Responde SIEMPRE con la tool responder, nunca solo con texto.\" }}",
        "options": {
          "systemMessage": "={{ $json.systemPrompt }}",
          "maxIterations": 12
        }
      },
      "id": "agente-2",
      "name": "Agente SDR",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [

    {
      "parameters": {
        "method": "POST",
        "url": "https://sdr.thecotocompany.com/api/messages/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"leadId\": \"{{ $('Lead a lead').item.json.id }}\", \"texto\": {{ JSON.stringify($json.output) }}, \"step\": 1, \"tipo\": \"mensaje\", \"nuevoEstado\": \"contactado\", \"nextActionAt\": \"{{ $now.plus(3, 'days').toISO() }}\" }",
        "options": {
          "timeout": 60000
        }
      },
